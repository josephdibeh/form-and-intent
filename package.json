{
  "name": "design-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src server tests docs *.json *.jsonc *.ts *.md .github",
    "format:check": "prettier --check src server tests docs *.json *.jsonc *.ts *.md .github",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787 --var ENABLED:true",
    "storybook": "storybook dev -p 6008 --host 127.0.0.1 --no-open --ci",
    "build-storybook": "storybook build",
    "dev:all": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "baseui": "^18.2.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
